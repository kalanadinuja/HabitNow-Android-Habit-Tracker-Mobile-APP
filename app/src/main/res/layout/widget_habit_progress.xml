<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Header Section with Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- App Icon/Logo -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_today"
            android:tint="@color/backgroundColor"
            android:layout_marginEnd="8dp"/>

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/backgroundColor"
                android:textSize="12sp"
                android:alpha="0.9"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvWidgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/today_habits"
                android:textColor="@color/backgroundColor"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Section with Custom Styling -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_progress_background"
        android:padding="10dp">

        <!-- Custom Progress Bar with Rounded Corners -->
        <ProgressBar
            android:id="@+id/widgetProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:minHeight="8dp"
            android:maxHeight="8dp"
            android:progressTint="@color/backgroundColor"
            android:progressBackgroundTint="@color/backgroundColor"
            android:alpha="0.8"
            android:progress="75" />

        <!-- Progress Status with Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_report_image"
                android:tint="@color/backgroundColor"
                android:alpha="0.9"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvWidgetProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/habit_progress_placeholder"
                android:textColor="@color/backgroundColor"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
