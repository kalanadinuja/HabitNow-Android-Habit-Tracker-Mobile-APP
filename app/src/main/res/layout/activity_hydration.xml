<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">


            <!-- Decorative elements -->
            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@color/colorAccent"
                android:alpha="0.12"
                android:translationY="-70dp"
                android:translationX="70dp"
                android:rotation="45"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@color/colorSecondary"
                android:alpha="0.1"
                android:translationY="-55dp"
                android:translationX="-55dp"
                android:rotation="30"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Header -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="413dp"
                android:layout_height="120dp"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="-2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="50dp">

                    <Button
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/colorPrimaryDark"
                        android:text="@string/back"
                        android:textColor="@color/backgroundColor"
                        app:cornerRadius="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/hydration_title"
                        android:textColor="@color/backgroundColor"
                        android:textSize="24sp"
                        android:layout_marginLeft="30dp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.appcompat.widget.Toolbar>
            
            <!-- Subtitle text -->
            <TextView
                android:id="@+id/hydrationSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stay hydrated for better health and wellbeing"
                android:textColor="@color/backgroundColor"
                android:textSize="16sp"
                android:layout_marginHorizontal="32dp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/toolbar"/>

            <!-- Hydration Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/hydrationSubtitle">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hydration Status"
                        android:textColor="@color/colorAccent"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:id="@+id/statusContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/statusTitle">

                        <!-- Water Icon in Circle -->

                        <!-- Status Text -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="16dp">
                            
                            <TextView
                                android:id="@+id/tvHydrationSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stay hydrated, stay healthy"
                                android:textSize="18sp"
                                android:textColor="@color/colorPrimary" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Water is essential for your body to function properly"
                                android:textSize="14sp"
                                android:textColor="@color/textColorPrimary"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reminder Settings Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/reminderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:layout_constraintTop_toBottomOf="@id/statusCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Reminder Settings Section -->
                    <TextView
                        android:id="@+id/tvSettingsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reminder_interval"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorAccent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Hours and Minutes Input -->
                    <LinearLayout
                        android:id="@+id/timeInputsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvSettingsHeader">

                        <!-- Hours Input -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hours"
                                android:textSize="16sp"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                android:layout_gravity="center_horizontal"/>
                                
                            <EditText
                                android:id="@+id/etHours"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:hint="2"
                                android:background="@drawable/rounded_edittext"
                                android:padding="16dp"
                                android:gravity="center"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <!-- Minutes Input -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/minutes"
                                android:textSize="16sp"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                android:layout_gravity="center_horizontal"/>
                                
                            <EditText
                                android:id="@+id/etMinutes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:hint="0"
                                android:background="@drawable/rounded_edittext"
                                android:padding="16dp"
                                android:gravity="center"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- First Reminder Time -->
                    <TextView
                        android:id="@+id/tvFirstReminderLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/first_reminder"
                        android:textColor="@color/colorAccent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="24dp"
                        app:layout_constraintTop_toBottomOf="@id/timeInputsLayout"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:id="@+id/timeSelectionLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvFirstReminderLabel">

                        <TextView
                            android:id="@+id/tvStartTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="08:00 AM"
                            android:textColor="@color/colorSecondary"
                            android:textSize="20sp"
                            android:background="@drawable/time_display_background"
                            android:padding="16dp"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnSetTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/set_time"
                            android:textColor="@color/backgroundColor"
                            android:backgroundTint="@color/colorPrimaryDark"
                            android:padding="16dp"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Information Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#F2F6FF"
                app:layout_constraintTop_toBottomOf="@id/reminderCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">


                    <Button
                        android:id="@+id/btnStartReminder"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:text="@string/start_reminder"
                        android:textColor="@color/backgroundColor"
                        android:backgroundTint="@color/colorAccent"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="12dp"
                        android:elevation="4dp" />

                    <Button
                        android:id="@+id/btnStopReminder"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorSecondary"
                        android:elevation="4dp"
                        android:text="@string/stop_reminder"
                        android:textColor="@color/backgroundColor"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>