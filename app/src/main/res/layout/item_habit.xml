<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">



            <!-- Habit Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHabitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Habit Name"
                    android:textSize="16sp"
                    android:textColor="@color/textColorPrimary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvHabitGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Goal: 1 times"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />
            </LinearLayout>

            <!-- Action Buttons -->
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_edit"
                android:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/edit_habit" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_delete"
                android:backgroundTint="@android:color/transparent"
                android:contentDescription="@string/delete_habit" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/habitProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/colorAccent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Complete Button -->
        <Button
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/habit_complete"
            android:textColor="@color/backgroundColor"
            android:backgroundTint="@color/buttonColor" />
    </LinearLayout>
</androidx.cardview.widget.CardView>