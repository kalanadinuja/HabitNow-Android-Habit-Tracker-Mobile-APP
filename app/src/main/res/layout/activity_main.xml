<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">


    <!-- Decorative elements -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@color/colorPrimary"
        android:layout_gravity="top|end"
        android:alpha="0.1"
        android:translationY="-90dp"
        android:translationX="90dp"
        android:rotation="45" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@color/colorSecondary"
        android:layout_gravity="top|start"
        android:alpha="0.1"
        android:translationY="-60dp"
        android:translationX="-60dp"
        android:rotation="30" />

    <!-- Main scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="60dp">

            <!-- User greeting and circle avatar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profilePreview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorPrimaryDark"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="@color/backgroundColor" />
            </androidx.cardview.widget.CardView>





            <!-- Main Dashboard Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/dashboardHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/dashboardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Home Page"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dashboardSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.7"
                                android:text="Select an option to track your well-being"
                                android:textColor="@color/textColorPrimary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Button section: vertical stack -->
                    <LinearLayout
                        android:id="@+id/buttonContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toBottomOf="@id/dashboardHeader"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Hydration Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHydration"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="6dp"
                            android:text="@string/btn_hydration"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimaryDark"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_recent_history"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />

                        <!-- Mood Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMood"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="6dp"
                            android:text="@string/btn_mood"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimaryDark"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_myplaces"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />

                        <!-- Habit Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHabit"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="16dp"
                            android:elevation="6dp"
                            android:text="@string/btn_habit"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimaryDark"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_agenda"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />

                        <!-- Profile Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfile"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:elevation="6dp"
                            android:text="@string/btn_profile"
                            android:textColor="@color/backgroundColor"
                            android:textSize="16sp"
                            app:backgroundTint="@color/colorPrimaryDark"
                            app:cornerRadius="28dp"
                            app:icon="@android:drawable/ic_menu_my_calendar"
                            app:iconGravity="textStart"
                            app:iconSize="24dp"
                            app:iconTint="@color/backgroundColor" />
                    </LinearLayout>

                    <!-- Quote of the day -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:cardBackgroundColor="#F5F9FF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/buttonContainer">


                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>